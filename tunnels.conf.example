# Copy this file to tunnels.conf in the same folder as TW.sh.
# This demo uses reserved example.invalid hosts and is not a working connection
# profile. Replace hosts, usernames, and forwards with your own values.
#
# Syntax:
#   machine ALIAS SSH_HOST SSH_USER IDENTITY_FILE GROUP
#   tunnel  DISPLAY_NAME LOCAL_FORWARD [LOCAL_HOSTNAME]
#   shell   DISPLAY_NAME SSH_TARGET
#   custom_command DISPLAY_NAME LOCAL_BASH_COMMAND
#   hosts_management yes|no
#   quick_launch_alt yes|no
#   name DISPLAY_NAME (optional window-title name)
#
# GROUP=yes: forwards for this machine share one SSH process.
# GROUP=no:  each forward gets its own SSH process.
#
# Leave private keys in ~/.ssh; do not copy them into this project folder.
# Optional: set the terminal title; this sample appears as "TW✦ Demo".
name "Demo"
# Default off. Set to yes to expose the Windows hosts menu; it NEVER edits
# the hosts file at startup. Use H, then A or R, preview and confirm manually.
hosts_management no
# Optional: Alt+1..Alt+9 open quick entries 10..18. Default is no;
# plain 1..9 always open the first nine. Later entries remain in the S menu.
quick_launch_alt no

# Dashboard demo: three tunnels, two configured local hostnames, and nine
# quick-launch SSH shells. The .test names are config-only; no system DNS or
# hosts-file entries are installed by this example.
# The first named tunnel demonstrates plain HTTP on port 80; the second uses
# HTTPS on port 443. Each hostname gets its own loopback IP. Binding ports
# below 1024 may require elevated privileges on some systems.
machine demo-api api-gateway.example.invalid alice ~/.ssh/id_ed25519 no
tunnel "API Gateway" 80:127.0.0.1:80 api.demo.test

machine demo-console admin-console.example.invalid alice ~/.ssh/id_ed25519 no
tunnel "Admin Console" 443:127.0.0.1:443 admin.demo.test

machine demo-metrics metrics-platform.example.invalid alice ~/.ssh/id_ed25519 no
tunnel "Metrics" 9090:127.0.0.1:9090

# Saved SSH shells and local Bash commands open in separate terminal windows
# when a supported launcher is available. Their declaration order determines
# the shared quick-launch grid; they need no machine or tunnel entry.
shell "Production API Server"       alice@api-gateway.example.invalid
shell "Web Frontend Services"       alice@web-frontend.example.invalid
shell "Build and CI Runner"          alice@build.example.invalid
shell "Primary Database"             alice@db.example.invalid
shell "Metrics Dashboard"            alice@metrics.example.invalid
shell "Staging Environment"          alice@staging.example.invalid
shell "Production Gateway"           alice@prod.example.invalid
shell "Application Logs"             alice@logs.example.invalid
shell "Developer Workstation"        alice@dev.example.invalid
# Host-wide aliases are managed separately with A in the UI (~/.bashrc).
